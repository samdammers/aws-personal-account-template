# Copy this to .envrc and fill in your values.
# .envrc is gitignored - never commit secrets.
# Run `direnv allow` after editing.

# Terraform variables - TF_VAR_* is read automatically by terraform
# Hardcoded to avoid an empty value if $AWS_DEFAULT_REGION isn't set, and a
# live AWS call on every direnv reload. Find your account ID with:
# aws sts get-caller-identity --query Account --output text
export TF_VAR_aws_region="us-east-1"
export TF_VAR_aws_account_id="123456789012"
export TF_VAR_owner_email="you@example.com"
export TF_VAR_account_owner_phone="+61400000000"

# Optional: creates a Route53 hosted zone for a domain you already own.
# Leave blank to skip - see domain_name's description for why domain
# registration itself isn't automated here.
export TF_VAR_domain_name=""

# Auth0 - create a Machine-to-Machine app in Auth0 with Management API access
export TF_VAR_auth0_domain=""
export TF_VAR_auth0_management_client_id=""
export TF_VAR_auth0_management_client_secret=""

# Populated after Apply 1 (copy from IAM Identity Center SAML metadata)
export TF_VAR_sso_saml_acs_url=""
export TF_VAR_sso_saml_audience=""

# Cosmetic - override if you forked/renamed this repo
# export TF_VAR_repo_tag="your-github-username/your-fork-name"

# Optional: plain email/password sign-in alongside Google, no Google account
# needed. Terraform generates the initial password itself (never a real,
# chosen one) - see enable_database_connection's description for the
# password-reset step needed after applying.
# export TF_VAR_enable_database_connection="true"
